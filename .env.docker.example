APP_NAME="Blog Open AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=blog
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# Required for image prompt generation
OPENAI_API_KEY=

# Optional — separate frontend URL for auth redirects
FRONTEND_URL=http://localhost:3000

# Docker port overrides (used by docker-compose, not Laravel)
# APP_PORT=8000
# PHPMYADMIN_PORT=8080
# MYSQL_PORT=3306
# MYSQL_ROOT_PASSWORD=root
